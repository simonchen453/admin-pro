# ============================================
# Docker 部署环境变量配置示例
# ============================================
# 复制此文件为 .env 并修改相应配置
# cp env.example .env

# ============================================
# 端口配置
# ============================================
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3306

# ============================================
# Spring Boot 配置
# ============================================
SPRING_PROFILES_ACTIVE=dev

# ============================================
# 数据库配置
# ============================================
# 如果使用 docker-compose 中的 MySQL 服务，使用服务名
DB_HOST=host.docker.internal
# 如果使用外部数据库，填写实际地址
# DB_HOST=host.docker.internal
# DB_HOST=192.168.1.100

DB_PORT=3306
DB_NAME=mistake_notebook
DB_USERNAME=adminpro
DB_PASSWORD=password$1
DB_USE_SSL=false

# MySQL Root 密码（仅在使用 docker-compose 中的 MySQL 时生效）
MYSQL_ROOT_PASSWORD=root123456

# ============================================
# 邮件配置（可选）
# ============================================
MAIL_HOST=smtp.example.com
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================
# 应用配置
# ============================================
APP_JDBC_SHOW_SQL=false
APP_CORS_ORIGINS=http://localhost:80,http://localhost:3000
APP_SWAGGER_ENABLED=true
APP_QUARTZ_STARTUP_DELAY=5

# ============================================
# 管理端点配置
# ============================================
MANAGEMENT_SECURITY_ENABLED=false

APP_BASE_PATH=/adminpro

# ============================================
# 后端连接配置 (Frontend -> Backend)
# ============================================
# 后端主机名 (默认: backend, 混合开发模式: host.docker.internal)
BACKEND_HOST=192.168.0.118
#BACKEND_HOST=192.168.8.114
# 后端 Context Path (必须与后端配置一致)
BACKEND_CONTEXT_PATH=/mn
BACKEND_PORT=8081
API_BASE_URL=/mn

